<?xml version="1.0" encoding="utf-8"?>
<!-- Shown in the widget picker on Android 12+. Only views RemoteViews can inflate. Mirrors MiniPlayerContent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_preview_artwork" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="@string/widget_preview_episode"
                android:textColor="@color/widget_preview_on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_podcast"
                android:textColor="@color/widget_preview_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_previous"
            android:tint="@color/widget_preview_on_surface" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_replay_10"
            android:tint="@color/widget_preview_on_surface" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_pause"
            android:tint="@color/widget_preview_on_surface" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_forward_30"
            android:tint="@color/widget_preview_on_surface" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next"
            android:tint="@color/widget_preview_on_surface" />
    </LinearLayout>
</LinearLayout>
